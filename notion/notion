#!/usr/bin/env python3
"""notion: read and write Notion pages over the REST API, with compact output (token: NOTION_TOKEN, or the macOS keychain item notion-api).
  notion get <page> [--part NAME]... [--props]   the page as compact Markdown. --part keeps one part: a heading and
                                                 what follows it up to the next heading of its level, or a callout
                                                 or toggle; NAME is any piece of its text. --props: properties only
  notion set <page> Name=Value ...               change properties; multi-select, relation and people take comma lists,
                                                 a date takes 2026-11-20 or 2026-11-20..2026-11-22, an empty value clears
  notion put <page> NAME [file|-] [--empty]      replace a part's body with Markdown (stdin when no file); a first line
                                                 "= text" renames the part's heading, callout or toggle. An empty body
                                                 is refused unless --empty (which clears the part)
  notion add <page> NAME [file|-]                insert Markdown at the top of a part (a History toggle is newest first)
  notion query <database> [Prop=V | Prop!=V]... [--cols A,B]   rows as TSV. = means equals (contains for text,
                                                 multi-select, relation); an empty V tests for empty; filters are ANDed
  notion new <database|page> "Title" [Name=Value ...] [file|-]   create a page (properties need a database parent);
                                                 the body is Markdown from the file, or stdin with -
  notion edit <page> "old text" "new text"       change text inside the one block (or table cell) that holds it,
                                                 matching the text as `notion get` prints it
  notion search <words>                          pages and databases whose title holds every word, as TSV
  notion trash <page>
Markdown also takes "> 📍 title" (a callout: 📍 blue, ✅ green, ❓ yellow, ⚠️ red) and "▸ title" (a toggle), each with
its content indented two spaces below; `get` prints pages in the same form, so a part can be read, edited and put back.
  notion --self-test
<page> and <database> take an ID or a notion.so URL. Every write prints what it changed as it now stands.
The integration sees only pages shared with it. Comments, views, history and full-text search are not covered."""
import importlib.machinery, importlib.util, os, re, sys

_p = os.path.join(os.path.dirname(os.path.realpath(__file__)), "notion-push")
_l = importlib.machinery.SourceFileLoader("notion_push", _p)
np = importlib.util.module_from_spec(importlib.util.spec_from_loader("notion_push", _l)); _l.exec_module(np)

def dash(i): h = np.page_id(i); return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:]}"
def plain(rt): return "".join(r.get("plain_text", "") for r in rt)

def text(rt):
    out = ""
    for r in rt:
        s = r.get("plain_text", ""); a = r.get("annotations") or {}
        core = s.strip()
        if core:
            if a.get("code"): core = f"`{core}`"
            if a.get("bold"): core = f"**{core}**"
            if a.get("italic"): core = f"*{core}*"
            if a.get("strikethrough"): core = f"~~{core}~~"
            if r.get("href"): core = f"[{core}]({r['href']})"
            s = s[:len(s) - len(s.lstrip())] + core + s[len(s.rstrip()):]
        out += s
    return out

def show(p):
    if not p: return ""
    t = p["type"]; v = p.get(t)
    if v in (None, [], ""): return ""
    if t in ("title", "rich_text"): return text(v)
    if t in ("select", "status"): return v["name"]
    if t == "multi_select": return ", ".join(x["name"] for x in v)
    if t == "relation": return ", ".join(x["id"].replace("-", "") for x in v) + (" (more)" if p.get("has_more") else "")
    if t == "people": return ", ".join(x.get("name") or x["id"] for x in v)
    if t == "date": return v["start"] + (".." + v["end"] if v.get("end") else "")
    if t in ("created_time", "last_edited_time"): return v[:10]
    if t == "formula": return str(v.get(v["type"]) if v.get(v["type"]) is not None else "")
    if t == "rollup":
        x = v.get(v["type"]); return str(len(x)) if isinstance(x, list) else ("" if x is None else str(x))
    if t == "unique_id": return f"{v.get('prefix') or ''}{v['number']}"
    if t in ("created_by", "last_edited_by"): return v.get("name") or ""
    if t == "files": return ", ".join(x.get("name", "") for x in v)
    return str(v)

# ---------- reading ----------
def children(c, bid):
    out, cur = [], None
    while True:
        r = c.call("GET", f"/blocks/{bid}/children?page_size=100" + (f"&start_cursor={cur}" if cur else ""))
        out += r["results"]
        if not r.get("has_more"): return out
        cur = r["next_cursor"]

def load(c, blocks):
    for b in blocks:
        if b.get("has_children") and b["type"] not in ("child_page", "child_database"): b["_kids"] = load(c, children(c, b["id"]))
    return blocks

def render(bs, ind=""):
    L, n = [], 0
    for b in bs:
        t = b["type"]; o = b.get(t) or {}; s = text(o.get("rich_text", [])); k = b.get("_kids", [])
        n = n + 1 if t == "numbered_list_item" else 0
        if t == "paragraph":
            if s: L.append(ind + s)
        elif t.startswith("heading_"): L.append(ind + "#" * int(t[-1]) + " " + s)
        elif t == "bulleted_list_item": L.append(ind + "- " + s)
        elif t == "numbered_list_item": L.append(f"{ind}{n}. {s}")
        elif t == "to_do": L.append(ind + ("- [x] " if o.get("checked") else "- [ ] ") + s)
        elif t == "toggle": L.append(ind + "▸ " + s)
        elif t == "callout": L.append((ind + "> " + ((o.get("icon") or {}).get("emoji") or "") + " " + s).rstrip())
        elif t == "quote": L.append(ind + "> " + s.replace("\n", "\n" + ind + "> "))
        elif t == "code": L += [ind + "```" + o.get("language", "")] + [ind + x for x in plain(o.get("rich_text", [])).split("\n")] + [ind + "```"]
        elif t == "divider": L.append(ind + "---")
        elif t == "table":
            for i, r in enumerate(k):
                cells = [text(x).replace("|", "\\|").replace("\n", " ") for x in r["table_row"]["cells"]]
                L.append(ind + "| " + " | ".join(cells) + " |")
                if i == 0 and o.get("has_column_header"): L.append(ind + "|" + "---|" * len(cells))
            k = []
        elif t in ("child_page", "child_database"): L.append(f"{ind}[{t[6:]}] {o.get('title', '')} ({b['id'].replace('-', '')})")
        elif t == "link_to_page": L.append(f"{ind}[link] {(o.get('page_id') or o.get('database_id') or '').replace('-', '')}")
        elif t in ("column_list", "column", "synced_block"): L += render(k, ind); k = []
        elif t in ("image", "file", "pdf", "video", "audio", "bookmark", "embed", "link_preview"):
            u = o.get("url") or ((o.get("external") or {}).get("url") if o.get("type") == "external" else "")
            L.append(f"{ind}[{t}] {text(o.get('caption', []))} {u or ''}".rstrip())
        else: L.append(f"{ind}[{t}]")
        if k: L += render(k, ind + "  ")
    return L

def level(b): return int(b["type"][-1]) if b["type"].startswith("heading_") else 0

def find(bs, name):
    """(start, end, container) of the first top-level heading, callout or toggle whose text contains name."""
    q = name.lower()
    for i, b in enumerate(bs):
        t = b["type"]
        if (level(b) or t in ("callout", "toggle")) and q in plain(b[t].get("rich_text", [])).lower(): return bounds(bs, i)
    sys.exit(f"no top-level heading, callout or toggle contains '{name}'")

def bounds(bs, i):
    b = bs[i]
    if not level(b) or b.get("has_children"): return i, i + 1, True
    j = i + 1
    while j < len(bs) and not (level(bs[j]) and level(bs[j]) <= level(b)): j += 1
    return i, j, False

def head(pg):
    props = pg["properties"]; tk = next(k for k, p in props.items() if p["type"] == "title")
    gone = " · in trash" if pg.get("archived") or pg.get("in_trash") else ""
    return tk, [f"# {plain(props[tk]['title'])}", f"id {pg['id'].replace('-', '')} · edited {pg['last_edited_time'][:16].replace('T', ' ')}{gone}"]

def prop_lines(props, keys=None):
    return [f"{k}: {v}" for k, p in props.items() if (keys is None or k in keys) and p["type"] not in ("title", "last_edited_time")
            for v in [show(p)] if v and v != "0"]

def get(c, pid, parts, props_only):
    pg = c.call("GET", f"/pages/{pid}"); tk, L = head(pg)
    if props_only or not parts: L += prop_lines(pg["properties"])
    if not props_only:
        top = children(c, pid)
        if parts:
            for name in parts: i, j, _ = find(top, name); L += render(load(c, top[i:j]))
        else: L += render(load(c, top))
    print("\n".join(L))

# ---------- writing ----------
def value(t, v):
    L = [x.strip() for x in v.split(",") if x.strip()]
    if t in ("title", "rich_text"): return np.cap(np.rich(v)) if v else []
    if t in ("status", "select"): return {"name": v} if v else None
    if t == "multi_select": return [{"name": x} for x in L]
    if t == "relation": return [{"id": dash(x)} for x in L]
    if t == "people": return [{"id": x} for x in L]
    if t == "date": a, _, b = v.partition(".."); return {"start": a, "end": b or None} if a else None
    if t == "number": return float(v) if v else None
    if t == "checkbox": return v.lower() in ("1", "true", "yes", "x")
    if t in ("url", "email", "phone_number"): return v or None
    sys.exit(f"cannot set a {t} property")

def setp(c, pid, pairs):
    props = c.call("GET", f"/pages/{pid}")["properties"]; out = {}
    for kv in pairs:
        k, eq, v = kv.partition("=")
        if not eq or k not in props: sys.exit(f"want Name=Value with Name one of: {', '.join(props)}")
        t = props[k]["type"]; out[k] = {t: value(t, v)}
    pg = c.call("PATCH", f"/pages/{pid}", {"properties": out})
    print("\n".join(head(pg)[1] + prop_lines(pg["properties"], out) + [f"{k}: (empty)" for k in out if not show(pg["properties"][k])]))

def source(rest):
    if rest and rest[0] != "-": return open(rest[0], encoding="utf-8").read()
    return sys.stdin.read()

def write(c, pid, name, md, mode, empty=False):
    lines = md.strip("\n").split("\n")
    rename = mode == "put" and lines[0].startswith("= ")
    blocks = np.convert("\n".join(lines[1:] if rename else lines))
    # a put with no body (empty stdin, an empty file) deleted the part's whole body
    if mode == "put" and not blocks and not empty:
        sys.exit("put: no body given, which would delete the part's whole body; pass --empty to clear it on purpose")
    top = children(c, pid); i, j, cont = find(top, name); b = top[i]; t = b["type"]
    if rename: c.call("PATCH", f"/blocks/{b['id']}", {t: {"rich_text": np.cap(np.rich(lines[0][2:].strip()))}})
    # put: the old body goes only once the new one is in, so a refused write (a 400) loses nothing
    old = (children(c, b["id"]) if cont else top[i + 1:j]) if mode == "put" else []
    if blocks:
        if cont: np.send(c, b["id"], blocks, start=(mode == "add"))
        else: np.send(c, pid, blocks, after=b["id"])
    for k in old: c.call("DELETE", f"/blocks/{k['id']}")
    top = children(c, pid); i, j, _ = bounds(top, next(n for n, x in enumerate(top) if x["id"] == b["id"]))  # by id: "= text" may rename it
    print("\n".join(render(load(c, top[i:j]))))

def new(c, parent, title, pairs, md):
    try: P = c.call("GET", f"/databases/{parent}")["properties"]
    except SystemExit: P = None
    if P is None:
        if pairs: sys.exit("properties need a database parent; a page parent takes only the title")
        par, props = {"page_id": parent}, {"title": {"title": np.cap(np.rich(title))}}
    else:
        tk = next(k for k, p in P.items() if p["type"] == "title")
        par, props = {"database_id": parent}, {tk: {"title": np.cap(np.rich(title))}}
        for kv in pairs:
            k, eq, v = kv.partition("=")
            if not eq or k not in P: sys.exit(f"want Name=Value with Name one of: {', '.join(P)}")
            props[k] = {P[k]["type"]: value(P[k]["type"], v)}
    pg = c.call("POST", "/pages", {"parent": par, "properties": props})
    blocks = np.convert(md) if md.strip() else []
    if blocks: np.send(c, pg["id"], blocks)
    print(f"created {pg['id'].replace('-', '')} with {sum(map(np.count, blocks))} blocks")

def edit(c, pid, old, new_):
    hits = []
    def walk(bs):
        for b in bs:
            t = b["type"]; o = b.get(t) or {}
            if t == "table_row": hits.extend((b, ci) for ci, cell in enumerate(o["cells"]) if old in text(cell))
            elif t == "code":
                if old in plain(o.get("rich_text", [])): hits.append((b, "code"))
            elif "rich_text" in o and old in text(o["rich_text"]): hits.append((b, None))
            walk(b.get("_kids", []))
    walk(load(c, children(c, pid)))
    if len(hits) != 1: sys.exit(f"'{old}' is in {len(hits)} blocks; quote more of it" if hits else f"'{old}' not found; copy it as `notion get` prints it")
    b, ci = hits[0]; t = b["type"]; o = b[t]
    if ci == "code": body = {"code": {"rich_text": np.chunks(plain(o["rich_text"]).replace(old, new_), None, None)}}
    elif ci is None: body = {t: {"rich_text": np.cap(np.rich(text(o["rich_text"]).replace(old, new_)))}}
    else:
        cells = [np.cap(np.rich(text(x))) for x in o["cells"]]; cells[ci] = np.cap(np.rich(text(o["cells"][ci]).replace(old, new_)))
        body = {"table_row": {"cells": cells}}
    r = c.call("PATCH", f"/blocks/{b['id']}", body)
    print("| " + " | ".join(text(x) for x in r["table_row"]["cells"]) + " |" if t == "table_row" else "\n".join(render([r])))

def search(c, q):
    r = c.call("POST", "/search", {"query": q, "page_size": 100}); words = q.lower().split(); hits = 0
    for x in r["results"]:  # Notion's ranking is loose: keep titles that hold every word
        t = plain(x.get("title", [])) if x["object"] == "database" else next((plain(p["title"]) for p in x["properties"].values() if p["type"] == "title"), "")
        if not all(w in t.lower() for w in words): continue
        hits += 1; gone = "(trash) " if x.get("archived") or x.get("in_trash") else ""
        print("\t".join([x["id"].replace("-", ""), x["object"], x["last_edited_time"][:10], gone + t]))
    if not hits: print("no title holds every word (new pages take a minute to be indexed); the MCP search also reads page bodies", file=sys.stderr)

# ---------- query ----------
def filters(P, args):
    f = []
    for a in args:
        m = re.match(r"^(.+?)(!?=)(.*)$", a)
        if not m or m.group(1) not in P: sys.exit(f"want Prop=V or Prop!=V with Prop one of: {', '.join(P)}")
        k, op, v = m.groups(); neg = op == "!="; t = P[k]["type"]
        if v == "": cond = {"is_not_empty" if neg else "is_empty": True}
        elif t in ("status", "select"): cond = {"does_not_equal" if neg else "equals": v}
        elif t in ("multi_select", "relation", "people", "title", "rich_text", "url", "email", "phone_number"):
            cond = {"does_not_contain" if neg else "contains": dash(v) if t in ("relation", "people") else v}
        elif t == "checkbox": cond = {"does_not_equal" if neg else "equals": v.lower() in ("1", "true", "yes", "x")}
        elif t == "number": cond = {"does_not_equal" if neg else "equals": float(v)}
        else: sys.exit(f"cannot filter a {t} property")
        f.append({"property": k, t: cond})
    return f

def query(c, db, args, cols):
    P = c.call("GET", f"/databases/{db}")["properties"]; f = filters(P, args); body = {"page_size": 100}
    if f: body["filter"] = {"and": f} if len(f) > 1 else f[0]
    tk = next(k for k, p in P.items() if p["type"] == "title")
    cols = cols or [k for k, p in P.items() if p["type"] in ("status", "select")]
    for k in cols:
        if k not in P: sys.exit(f"no column {k}; have: {', '.join(P)}")
    rows, cur = [], None
    while True:
        if cur: body["start_cursor"] = cur
        r = c.call("POST", f"/databases/{db}/query", body); rows += r["results"]
        if not r.get("has_more"): break
        cur = r["next_cursor"]
    cell = lambda p: show(p).replace("\t", " ").replace("\n", " ")
    print("\t".join(["id", tk] + cols))
    for x in rows: print("\t".join([x["id"].replace("-", ""), cell(x["properties"][tk])] + [cell(x["properties"].get(k)) for k in cols]))
    print(f"{len(rows)} rows", file=sys.stderr)

# ---------- self-test ----------
def api(blocks):
    """notion-push blocks -> the shape GET returns, for round-trip tests."""
    out = []
    for b in blocks:
        t = b["type"]; o = dict(b[t]); k = o.pop("children", [])
        for key in ("rich_text",):
            if key in o: o[key] = [{"plain_text": r["text"]["content"], "annotations": r.get("annotations", {}), "href": (r["text"].get("link") or {}).get("url")} for r in o[key]]
        if t == "table_row": o["cells"] = [api([{"type": "paragraph", "paragraph": {"rich_text": c}}])[0]["paragraph"]["rich_text"] for c in o["cells"]]
        x = {"id": "id", "type": t, t: o, "has_children": bool(k)}
        if k: x["_kids"] = api(k)
        out.append(x)
    return out

def self_test():
    md = ("Goal with **bold**, *it*, `code`, ~~old~~ and [a link](https://x.io).\n## Decisions\n| Decision | Since |\n|---|---|\n"
          "| **New** | 20 Nov |\n## Context\n- a\n  - a1\n1. one\n2. two\n- [x] done\n```py\nx = 1\n```\n> quoted\n---\n# Next")
    got = render(api(np.convert(md)))
    want = ["Goal with **bold**, *it*, `code`, ~~old~~ and [a link](https://x.io).", "## Decisions", "| Decision | Since |", "|---|---|",
            "| **New** | 20 Nov |", "## Context", "- a", "  - a1", "1. one", "2. two", "- [x] done", "```python", "x = 1", "```", "> quoted", "---", "# Next"]
    assert got == want, "\n".join(got)
    bs = api(np.convert("## A\npara\n### A.1\nx\n## B\ny"))
    assert find(bs, "a") == (0, 4, False) and find(bs, "a.1") == (2, 4, False) and find(bs, "B") == (4, 6, False)
    bs.insert(0, {"type": "callout", "callout": {"rich_text": [{"plain_text": "Current state – 20 Nov"}], "icon": {"emoji": "📍"}}, "has_children": True})
    assert find(bs, "current state") == (0, 1, True) and render(bs[:1]) == ["> 📍 Current state – 20 Nov"]
    P = {"Status": {"type": "status"}, "Tags": {"type": "multi_select"}, "Blocked By": {"type": "relation"}, "Task name": {"type": "title"}}
    f = filters(P, ["Status!=Done", "Tags=Website", "Blocked By!=", "Task name=Launch", "Blocked By=0123456789abcdef0123456789abcdef"])
    assert f[0] == {"property": "Status", "status": {"does_not_equal": "Done"}} and f[2] == {"property": "Blocked By", "relation": {"is_not_empty": True}}
    assert f[3]["title"] == {"contains": "Launch"} and f[4]["relation"]["contains"] == "01234567-89ab-cdef-0123-456789abcdef"
    assert value("date", "2026-11-20..2026-11-22") == {"start": "2026-11-20", "end": "2026-11-22"} and value("status", "") is None
    assert value("multi_select", "a, b") == [{"name": "a"}, {"name": "b"}] and value("rich_text", "**x**")[0]["annotations"]["bold"]
    md2 = "> 📍 Current state – 20 Nov 2026\n  - one **b**\n▸ History\n  - 20 Nov: two\n> ❓\n  - None yet."
    assert render(api(np.convert(md2))) == md2.split("\n"), render(api(np.convert(md2)))
    # a put that Notion refuses deletes nothing, and a put that renames its part still prints it
    class Fake:
        def __init__(s, fail): s.fail, s.log, s.top = fail, [], api(np.convert("## Part\nold\n## End"))
        def call(s, m, path, body=None, v=None):
            s.log.append((m, path))
            if m == "GET": return {"results": s.top}
            if path.endswith("/children"):
                if s.fail: raise SystemExit("Notion 400")
                return {"results": [{"id": f"n{k}"} for k in range(len(body["children"]))]}
            if m == "PATCH": s.top[0]["heading_2"]["rich_text"] = [{"plain_text": r["text"]["content"]} for r in body["heading_2"]["rich_text"]]
            return {}
    f = Fake(True)
    for n, x in enumerate(f.top): x["id"] = f"b{n}"
    try: write(f, "pg", "Part", "new", "put")
    except SystemExit: pass
    assert not [x for x in f.log if x[0] == "DELETE"], f.log
    f = Fake(False); out = __import__("io").StringIO()
    for n, x in enumerate(f.top): x["id"] = f"b{n}"
    with __import__("contextlib").redirect_stdout(out): write(f, "pg", "Part", "= Renamed\nnew", "put")
    assert out.getvalue().startswith("## Renamed") and [m for m, _ in f.log].index("DELETE") > f.log.index(("PATCH", "/blocks/pg/children")), f.log
    # an empty put sends nothing unless --empty; an unknown flag stops before any request
    for body in ("", "\n\n", "= Renamed\n"):
        f = Fake(False)
        try: write(f, "pg", "Part", body, "put"); raise AssertionError(f"empty put {body!r} accepted")
        except SystemExit as e: assert "--empty" in str(e) and not f.log, f.log
    f = Fake(False)
    for n, x in enumerate(f.top): x["id"] = f"b{n}"
    with __import__("contextlib").redirect_stdout(__import__("io").StringIO()): write(f, "pg", "Part", "", "put", empty=True)
    assert [m for m, _ in f.log].count("DELETE") == 1, f.log
    for argv in (["trash", "0" * 32, "--dry-run"], ["put", "0" * 32, "Part", "--emtpy"]):
        try: main(argv); raise AssertionError(f"unknown flag accepted: {argv}")
        except SystemExit as e: assert "unknown flag" in str(e), e
    print("self-test ok: render round trip, part bounds, filters, property values, put order and rename, empty put, unknown flags")

# ---------- main ----------
def main(a):
    if not a or a[0] in ("-h", "--help"): sys.exit(__doc__)
    if a[0] == "--self-test": return self_test()
    cmd, rest = a[0], a[1:]
    parts = [rest[i + 1] for i, x in enumerate(rest) if x == "--part" and i + 1 < len(rest)]
    cols = next((rest[i + 1].split(",") for i, x in enumerate(rest) if x == "--cols" and i + 1 < len(rest)), None)
    flag = lambda i, x: x.startswith("--") and (i == 0 or rest[i - 1] not in ("--part", "--cols"))
    # an unknown flag was a positional, so `trash <id> --dry-run` really trashed the page
    bad = [x for i, x in enumerate(rest) if flag(i, x) and x not in ("--part", "--cols", "--props", "--empty")]
    if bad: sys.exit(f"unknown flag {bad[0]}: notion takes --part, --cols, --props and --empty (put); nothing was sent")
    pos = [x for i, x in enumerate(rest) if not flag(i, x) and (i == 0 or rest[i - 1] not in ("--part", "--cols"))]
    if not pos: sys.exit(__doc__)
    c = np.Client(np.token(), False); c.quiet = True
    if cmd == "search": return search(c, " ".join(pos))
    pid = np.page_id(pos[0])
    if cmd == "new" and len(pos) > 1:
        rest = pos[2:]; f = rest.pop() if rest and "=" not in rest[-1] else None
        return new(c, pid, pos[1], rest, sys.stdin.read() if f == "-" else open(f, encoding="utf-8").read() if f else "")
    if cmd == "edit" and len(pos) == 3: return edit(c, pid, pos[1], pos[2])
    if cmd == "get": get(c, pid, parts, "--props" in rest)
    elif cmd == "set" and len(pos) > 1: setp(c, pid, pos[1:])
    elif cmd in ("put", "add") and len(pos) > 1: write(c, pid, pos[1], source(pos[2:]), cmd, "--empty" in rest)
    elif cmd == "query": query(c, pid, pos[1:], cols)
    elif cmd == "trash": c.call("PATCH", f"/pages/{pid}", {"archived": True}); print("trashed", pid)
    else: sys.exit(__doc__)

if __name__ == "__main__": main(sys.argv[1:])
