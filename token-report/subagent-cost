#!/usr/bin/env -S python3 -I
"""Token use per subagent of one session, grouped by agent type (the subagent_type each was started with).
Usage: subagent-cost <session id or its subagents dir>   |   subagent-cost --self-test
Input = fresh + cache reads + cache writes, once per message."""
import collections, glob, json, pathlib, sys


def load(d):
    rows = []
    for m in d.glob("*.meta.json"):
        meta = json.loads(m.read_text()); desc = meta.get("description") or meta.get("agentType") or "?"
        seen, inp, out, calls, peak, first, model = set(), 0, 0, 0, 0, None, "?"
        jl = d / m.name.replace(".meta.json", ".jsonl")
        if not jl.exists(): continue  # a meta file whose transcript is gone
        for line in jl.open(errors="replace"):
            try: j = json.loads(line)
            except Exception: continue
            msg = j.get("message") or {}; u = msg.get("usage"); mid = msg.get("id")
            if not u or mid in seen: continue
            seen.add(mid); c = u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
            inp += c; out += u.get("output_tokens", 0); calls += 1; peak = max(peak, c); first = first or c; model = msg.get("model", model)
        if calls:  # a transcript with no assistant message has nothing to count
            rows.append((desc, inp, out, calls, peak, first or 0, model, meta.get("agentType") or "other"))
    return rows


def report(rows):
    g = collections.defaultdict(lambda: [0, 0, 0, 0])
    for r in rows:
        k = r[7]; g[k][0] += 1; g[k][1] += r[1]; g[k][2] += r[3]; g[k][3] = max(g[k][3], r[4])
    tot = sum(r[1] for r in rows)
    print(f"{len(rows)} subagents, {tot/1e6:.1f}M input, {sum(r[2] for r in rows)/1e6:.2f}M output, {sum(r[3] for r in rows)} calls")
    print("agent type               runs   input   share  calls/run  M/run  peak")
    for k, (n, i, c, p) in sorted(g.items(), key=lambda x: -x[1][1]):
        print(f"{k:24} {n:4} {i/1e6:7.1f}M {100*i/(tot or 1):5.1f}%  {c/n:8.0f}  {i/n/1e6:5.2f}  {p/1e3:4.0f}k")
    print("\ncalls per run: median", sorted(r[3] for r in rows)[len(rows)//2], " start ctx median", sorted(r[5] for r in rows)[len(rows)//2]//1000, "k")
    print("\ncostliest 12:")
    for r in sorted(rows, key=lambda r: -r[1])[:12]:
        print(f"  {r[1]/1e6:5.1f}M {r[3]:4} calls peak {r[4]/1e3:4.0f}k  {r[0][:60]}")


def self_test():
    import contextlib, io, tempfile
    with tempfile.TemporaryDirectory() as t:
        d = pathlib.Path(t)
        (d / "agent-a.meta.json").write_text('{"description": "x", "agentType": "worker"}')
        (d / "agent-a.jsonl").write_text('{"message": {"id": "m1", "model": "m", "usage": {"input_tokens": 5, "output_tokens": 2}}}\n')
        (d / "agent-b.meta.json").write_text('{"description": "empty"}')
        (d / "agent-b.jsonl").write_text("")
        (d / "agent-c.meta.json").write_text('{"description": "no transcript"}')
        rows = load(d)
        assert len(rows) == 1 and rows[0][7] == "worker", rows
        out = io.StringIO()
        with contextlib.redirect_stdout(out): report(rows); report([("z", 0, 0, 1, 0, 0, "?", "other")])  # zero total: no division
        assert "1 subagents" in out.getvalue()
    print("self-test ok")


if sys.argv[1:] == ["--self-test"]:
    self_test()
elif len(sys.argv) != 2:
    sys.exit("usage: subagent-cost <session id or subagents dir> | --self-test")
else:
    d = pathlib.Path(sys.argv[1])
    if not d.is_dir():
        d = pathlib.Path(next(iter(glob.glob(str(pathlib.Path.home() / ".claude/projects/*" / sys.argv[1] / "subagents"))), sys.argv[1]))
    rows = load(d) if d.is_dir() else []
    report(rows) if rows else sys.exit(f"no subagent runs with messages found for {sys.argv[1]}")
